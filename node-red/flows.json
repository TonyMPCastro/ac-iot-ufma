    {
        "id": "mqtt_in_sensores_auto",
        "type": "mqtt in",
        "z": "fluxo_5_salas",
        "name": "Receber Sensores (Auto)",
        "topic": "ac-iot/+/sensores",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_docker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 140,
        "wires": [
            [
                "function_automacao",
                "debug_telemetria"
            ]
        ]
    },
    {
        "id": "function_automacao",
        "type": "function",
        "z": "fluxo_5_salas",
        "name": "Lógica de Automação",
        "func": "// Extração segura do ID da sala\nvar id_sala = msg.payload.id_sala;\nvar temp = msg.payload.temperatura || 0;\n\nif (!id_sala && msg.topic) {\n    var partes = msg.topic.split('/');\n    if (partes.length >= 2) id_sala = partes[1];\n}\n\nif (!id_sala) return null;\n\n// Histerese: Ligar > 24, Desligar < 22\nvar ac_cmd = \"\";\nif (temp > 24) ac_cmd = \"ligar\";\nelse if (temp < 22) ac_cmd = \"desligar\";\n\nif (ac_cmd === \"\") return null; \n\nreturn {\n    topic: \"ac-iot/\" + id_sala + \"/comando\",\n    payload: { \"comando\": ac_cmd }\n};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 140,
        "wires": [
            [
                "mqtt_out_comandos"
            ]
        ]
    },
    {
        "id": "mqtt_out_comandos",
        "type": "mqtt out",
        "z": "fluxo_5_salas",
        "name": "Enviar Comandos",
        "topic": "",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt_broker_docker",
        "x": 750,
        "y": 140,
        "wires": []
    },
