    {
        "id": "function_automacao",
        "type": "function",
        "z": "fluxo_5_salas",
        "name": "Lógica de Automação",
        "func": "// Extração segura do ID da sala\nvar id_sala = msg.payload.id_sala;\nvar temp = msg.payload.temperatura || 0;\n\nif (!id_sala && msg.topic) {\n    var partes = msg.topic.split('/');\n    if (partes.length >= 2) id_sala = partes[1];\n}\n\nif (!id_sala) {\n    node.warn(\"ID da sala não encontrado\");\n    return null;\n}\n\n// Ligar se > 24°C, desligar se < 22°C\nvar comando = \"\";\nif (temp > 24) comando = \"ligar\";\nelse if (temp < 22) comando = \"desligar\";\n\nif (comando === \"\") return null;\n\nreturn {\n    topic: \"ac-iot/\" + id_sala + \"/comando\",\n    payload: { \"comando\": comando }\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 140,
        "wires": [
            [
                "mqtt_out_comandos",
                "debug_comandos"
            ]
        ]
    },
