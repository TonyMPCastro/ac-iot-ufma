# ============================================
# .gitignore — ac-iot-ufma
# ============================================

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Agentes IA ────────────────────────────────
.agents/

# ── PlatformIO ────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
.piorepo/
firmware/esp32/.pio/
firmware/esp32/lib/
firmware/esp32/include/
firmware/esp32/test/

# ── Wokwi ─────────────────────────────────────
# (mantém diagram.json e wokwi.toml no repo)

# ── Node.js ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tgz

# ── Docker volumes persistentes (dados locais) ─
docker/mosquitto/data/
docker/mosquitto/log/
docker/nodered/data/

# ── Variáveis de ambiente ─────────────────────
.env
.env.local
.env.*.local

# ── Sistema Operacional ───────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── Build / Dist ──────────────────────────────
dist/
build/
out/
